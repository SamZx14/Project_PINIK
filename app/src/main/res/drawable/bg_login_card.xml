<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent white -->
    <solid android:color="#8A0A1D19" />

    <!-- Soft glass border -->
    <stroke
        android:width="1dp"
        android:color="#0A0A1D19" />

    <corners android:radius="28dp" />

    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>