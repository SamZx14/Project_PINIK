<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="3dp"
    android:paddingEnd="3dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/pinik_glass_light"
        app:cardCornerRadius="21dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/pinik_glass_stroke"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imageFeatureIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/ic_home_more"
            app:tint="@color/pinik_accent_yellow" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textFeatureLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="1"
        android:text="@string/pinik_more"
        android:textColor="@color/pinik_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
