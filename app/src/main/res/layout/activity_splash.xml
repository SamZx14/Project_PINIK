<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#001B14">

    <!-- Full-screen mountain background -->
    <ImageView
        android:id="@+id/imageSplashBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/pinik_splash_background" />

    <!-- Gradient for better text visibility -->

    <!-- Pinik logo -->

    <!-- Loading area -->

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_overlay" />

    <ImageView
        android:id="@+id/imagePinikLogo"
        android:layout_width="353dp"
        android:layout_height="199dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/splash_logo_description"
        android:scaleType="fitCenter"
        android:src="@drawable/pinik_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="44dp">

        <ProgressBar
            android:id="@+id/progressBarSplash"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminate="true"
            android:indeterminateTint="#A7F3D8" />

        <TextView
            android:id="@+id/textSplashLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="@string/splash_loading"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

    </LinearLayout>

</FrameLayout>