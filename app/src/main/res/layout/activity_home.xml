<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pinik_accent_green_dark">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_overlay" />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_pinik_home_overlay" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="40dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/buttonMenu"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:clickable="true"
                        android:contentDescription="@string/pinik_open_menu"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:cardBackgroundColor="@color/pinik_glass_light"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/pinik_glass_stroke"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="11dp"
                            android:src="@drawable/ic_home_menu"
                            app:tint="@color/pinik_text_primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textGreeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/pinik_home_greeting_default"
                        android:textColor="@color/pinik_text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/buttonMenu"
                        app:layout_constraintEnd_toStartOf="@id/buttonNotification"
                        app:layout_constraintStart_toEndOf="@id/buttonMenu"
                        app:layout_constraintTop_toTopOf="@id/buttonMenu" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/pinik_ready_for_adventure"
                        android:textColor="@color/pinik_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/buttonNotification"
                        app:layout_constraintStart_toEndOf="@id/buttonMenu"
                        app:layout_constraintTop_toBottomOf="@id/textGreeting" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/buttonNotification"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:clickable="true"
                        android:contentDescription="@string/pinik_open_notifications"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:cardBackgroundColor="@color/pinik_glass_light"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/pinik_glass_stroke"
                        app:strokeWidth="1dp">


                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="10dp"
                                android:src="@drawable/ic_home_notification"
                                app:tint="@color/pinik_text_primary" />

                            <View
                                android:id="@+id/notificationDot"
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="7dp"
                                android:layout_marginEnd="7dp"
                                android:background="@drawable/bg_pinik_notification_dot"
                                android:visibility="gone" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ProgressBar
                    android:id="@+id/progressHome"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_horizontal"
                    android:indeterminateTint="@color/pinik_white"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/pinik_upcoming_tour"
                    android:textColor="@color/pinik_text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutNoTour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/pinik_glass_dark"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/pinik_glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/pinik_no_upcoming_tour"
                            android:textColor="@color/pinik_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/pinik_no_upcoming_tour_description"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonCreateFirstTour"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="18dp"
                            android:text="@string/pinik_create_tour"
                            android:textAllCaps="false"
                            android:textColor="@color/pinik_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/pinik_accent_green"
                            app:cornerRadius="16dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpcomingTour"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:contentDescription="@string/pinik_open_upcoming_tour"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/pinik_glass_dark"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="7dp"
                    app:strokeColor="@color/pinik_glass_stroke"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/pinik_splash_background"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@drawable/bg_pinik_tour_overlay"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textTourTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="22dp"
                            android:layout_marginEnd="20dp"
                            android:text="@string/pinik_untitled_tour"
                            android:textColor="@color/pinik_text_primary"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textTourDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="15dp"
                            android:text="@string/pinik_date_not_added"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textTourTitle" />

                        <ImageView
                            android:id="@+id/iconTourLocation"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_location"
                            app:tint="@color/pinik_text_secondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textTourDate" />

                        <TextView
                            android:id="@+id/textTourLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:layout_marginEnd="20dp"
                            android:text="@string/pinik_location_not_added"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="@id/iconTourLocation"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/iconTourLocation"
                            app:layout_constraintTop_toTopOf="@id/iconTourLocation" />

                        <TextView
                            android:id="@+id/textTourDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="18dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_pinik_activity_avatar"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/pinik_tour_duration_preview"
                            android:textColor="@color/pinik_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="17dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_pinik_activity_avatar"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_home_arrow"
                            app:tint="@color/pinik_text_primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/cardItinerary"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardVote"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardExpenses"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardTasks"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/cardMap"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardMembers"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardPhotos"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardMore"
                        layout="@layout/item_home_feature_glass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/pinik_recent_activity"
                    android:textColor="@color/pinik_text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutRecentEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/pinik_glass_dark"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="5dp"
                    app:strokeColor="@color/pinik_glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/pinik_no_recent_activity"
                            android:textColor="@color/pinik_text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textRecentEmptyMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/pinik_no_recent_activity_description"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/recentActivityGlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/pinik_glass_dark"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="5dp"
                    app:strokeColor="@color/pinik_glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/recentActivityContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/bottomNavigationContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                app:cardBackgroundColor="@color/pinik_glass_darker"
                app:cardCornerRadius="27dp"
                app:cardElevation="12dp"
                app:strokeColor="@color/pinik_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:id="@+id/navHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_nav_home"
                            app:tint="@color/pinik_accent_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pinik_home"
                            android:textColor="@color/pinik_accent_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navTours"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_nav_tours"
                            app:tint="@color/pinik_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pinik_tours"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/buttonAddTour"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:contentDescription="@string/pinik_add_tour_description"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:cardBackgroundColor="@color/pinik_accent_green"
                        app:cardCornerRadius="29dp"
                        app:cardElevation="5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="16dp"
                            android:src="@drawable/ic_home_add"
                            app:tint="@color/pinik_white" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/navChat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_chat"
                            app:tint="@color/pinik_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pinik_chat"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navProfile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_home_profile"
                            app:tint="@color/pinik_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pinik_profile"
                            android:textColor="@color/pinik_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>