<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->

    <ImageView
        android:id="@+id/imageForgotBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/forgot_and_registration" />

    <!-- Dark Gradient Overlay -->

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_overlay" />

    <!-- Content -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/forgotPasswordScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="30dp"
            android:paddingEnd="22dp"
            android:paddingBottom="36dp">

            <!-- Back Button -->

            <TextView
                android:id="@+id/textBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:text="←  Back to Login"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Logo -->

            <ImageView
                android:id="@+id/imageForgotPasswordLogo"
                android:layout_width="190dp"
                android:layout_height="150dp"
                android:layout_marginTop="0dp"
                android:contentDescription="Pinik logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <!-- Title -->

            <TextView
                android:id="@+id/textForgotPasswordTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Forgot Password?"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textForgotPasswordDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Enter your registered email address and we will send you a secure password reset link."
                android:textColor="#D9FFFFFF"
                android:textSize="15sp" />

            <!-- Glass Card -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/forgotPasswordCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#99191B17"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:strokeColor="#66FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/textResetEmailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registered email"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Email Input -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutResetEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Email address"
                        app:boxBackgroundColor="#26FFFFFF"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="#B3FFFFFF"
                        app:hintTextColor="#E6FFFFFF"
                        app:startIconDrawable="@android:drawable/ic_dialog_email"
                        app:startIconTint="#FFFFFF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextResetEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionDone"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingTop="17dp"
                            android:paddingBottom="17dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#B3FFFFFF"
                            android:textCursorDrawable="@null"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Send Button -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSendResetLink"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="22dp"
                        android:backgroundTint="#197653"
                        android:text="Send Reset Link"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:elevation="4dp" />

                    <ProgressBar
                        android:id="@+id/progressReset"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textResetHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Didn't receive the email? Check your spam folder and confirm that the address is correct."
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>