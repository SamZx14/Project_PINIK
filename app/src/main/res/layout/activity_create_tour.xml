<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createTourMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pinik_accent_green_dark">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_overlay" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/createTourScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/textCreateTourBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:text="@string/pinik_back"
                android:textColor="@color/pinik_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pinik_create_new_tour"
                android:textColor="@color/pinik_text_primary"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/pinik_create_tour_description"
                android:textColor="@color/pinik_text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/pinik_glass_dark"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/pinik_glass_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutTourTitle"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/pinik_tour_title"
                        app:boxBackgroundColor="@color/pinik_glass_input"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/pinik_glass_stroke"
                        app:hintTextColor="@color/pinik_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTourTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:textColor="@color/pinik_text_primary"
                            android:textColorHint="@color/pinik_text_muted" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutTourLocation"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/pinik_tour_location"
                        app:boxBackgroundColor="@color/pinik_glass_input"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/pinik_glass_stroke"
                        app:hintTextColor="@color/pinik_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTourLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:imeOptions="actionNext"
                            android:inputType="textPostalAddress|textCapWords"
                            android:maxLines="1"
                            android:textColor="@color/pinik_text_primary"
                            android:textColorHint="@color/pinik_text_muted" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutStartDate"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/pinik_start_date"
                        app:boxBackgroundColor="@color/pinik_glass_input"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/pinik_glass_stroke"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:endIconTint="@color/pinik_text_primary"
                        app:hintTextColor="@color/pinik_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editStartDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textColor="@color/pinik_text_primary"
                            android:textColorHint="@color/pinik_text_muted" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEndDate"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/pinik_end_date"
                        app:boxBackgroundColor="@color/pinik_glass_input"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/pinik_glass_stroke"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                        app:endIconTint="@color/pinik_text_primary"
                        app:hintTextColor="@color/pinik_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editEndDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:textColor="@color/pinik_text_primary"
                            android:textColorHint="@color/pinik_text_muted" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/pinik_tour_description"
                        app:boxBackgroundColor="@color/pinik_glass_input"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/pinik_glass_stroke"
                        app:hintTextColor="@color/pinik_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTourDescription"
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="5"
                            android:textColor="@color/pinik_text_primary"
                            android:textColorHint="@color/pinik_text_muted" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSaveTour"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/pinik_save_tour"
                        android:textAllCaps="false"
                        android:textColor="@color/pinik_white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/pinik_accent_green"
                        app:cornerRadius="17dp" />

                    <ProgressBar
                        android:id="@+id/progressCreateTour"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:indeterminateTint="@color/pinik_white"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
